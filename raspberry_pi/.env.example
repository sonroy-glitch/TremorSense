# ---- TremorSense cane (Raspberry Pi) ----
# Copy to raspberry_pi/.env on the device and fill in.

# Must match the Cane ID the patient signed up with in the web app.
CANE_ID=TS-4F2A-9C71

# Backend base URL, no trailing slash. Your Northflank service in production.
API_BASE_URL=http://192.168.0.10:3004

# Must match PI_INGEST_KEY in the backend's environment.
PI_INGEST_KEY=replace-me

# ---- sensor input ----
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200
SAMPLE_RATE_HZ=64

# ---- inference ----
# Defaults to tremorsense/model/model.pkl (and scaler.pkl if you use one).
# If the folder holds exactly one .pkl, it is used regardless of its name.
# MODEL_PATH=/home/pi/TremorSenseProject/raspberry_pi/tremorsense/model/model.pkl
# SCALER_PATH=/home/pi/TremorSenseProject/raspberry_pi/tremorsense/model/scaler.pkl

# How a window becomes model input. MUST match how the model was trained.
#   sample   = one row per sample: [time_ms, 8 channels] -> 9 features.
#              This is what the shipped RandomForest expects.
#   raw      = the flattened window (WINDOW_SAMPLES x 8 values)
#   features = 56 summary statistics
FEATURE_MODE=sample

# What goes in the model's `time of sample_ms` feature. The shipped model was
# trained with the timestamp as a real feature, so this matters:
#   elapsed = ms since this process started classifying (closest to training,
#             where each recording session began near 0)
#   board   = the sensor board's own clock, verbatim
#   zero    = always 0, neutralising the feature
# If detections look arbitrary, try `zero` and compare — see the warning in
# tremorsense/model/README.md.
TIME_FEATURE=elapsed

# In `sample` mode a window is purely a smoothing and batching unit: all its
# samples are predicted in one call and then vote. 64 @ 64Hz = 1 second,
# non-overlapping, which keeps the hourly time totals exact.
WINDOW_SAMPLES=64
WINDOW_STRIDE_SAMPLES=64

# A sample counts as frozen when its freeze probability reaches
# FREEZE_THRESHOLD; the window is frozen when at least FREEZE_VOTE_RATIO of its
# samples are. Raise either for fewer, more confident detections.
FREEZE_THRESHOLD=0.5
FREEZE_VOTE_RATIO=0.5

# Episodes shorter than this are discarded as noise.
MIN_EPISODE_MS=1000
# Freezes closer together than this are merged into one episode.
EPISODE_MERGE_GAP_MS=2000

# ---- storage and upload ----
# DB_PATH=/home/pi/TremorSenseProject/raspberry_pi/data/tremorsense.sqlite3
UPLOAD_INTERVAL_S=300
UPLOAD_BATCH_SIZE=200
CONNECTIVITY_URL=https://www.google.com/generate_204
CONNECTIVITY_TIMEOUT_S=5
LOG_LEVEL=INFO
