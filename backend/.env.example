# ---- TremorSense backend ----
# Copy to .env for local dev; set the same keys as Northflank env vars in prod.

NODE_ENV=development
PORT=3004

# Postgres. Prisma 7 connects through the pg driver adapter.
DATABASE_URL=postgresql://user:password@host:5432/tremorsense?schema=public

# Signs the web app's JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me
JWT_EXPIRES_IN=30d

# Shared secret the Raspberry Pi sends as `x-api-key` on POST /pi_data.
# Must match PI_INGEST_KEY in raspberry_pi/.env. Generate with: openssl rand -hex 32
PI_INGEST_KEY=replace-me

# FOG Assistant chatbot (POST /llm_bot). https://console.groq.com/keys
GROQ_API_KEY=replace-me
GROQ_MODEL=openai/gpt-oss-120b

# Browser origins allowed to call this API, comma-separated.
# Local dev + your Vercel domain, e.g.
# CORS_ORIGINS=http://localhost:8080,https://tremorsense.vercel.app
CORS_ORIGINS=http://localhost:8080

# Optional: cap the Postgres connection pool (small tiers / pgbouncer).
# PG_POOL_MAX=10
