# ---- TremorSense backend ----
# Copy to .env for local dev; set the same keys as Northflank env vars in prod.

NODE_ENV=development
PORT=3004

# Postgres, used by the running app. A transaction-mode pooler is fine here —
# the pg driver adapter does not use named prepared statements unless you give
# it a statementNameGenerator, which this project does not.
DATABASE_URL=postgresql://user:password@host:5432/tremorsense?schema=public

# Only needed when DATABASE_URL is a transaction-mode pooler (Supabase port
# 6543, PgBouncer, Supavisor). The Prisma CLI uses this for `migrate deploy`,
# which issues `SET session_replication_role` and takes a session-level
# advisory lock — neither works through a transaction pooler.
# Same database, session-mode port. For Supabase that is the same host on 5432:
#   DATABASE_URL=postgresql://USER:PASS@aws-0-REGION.pooler.supabase.com:6543/postgres
#   DIRECT_URL=postgresql://USER:PASS@aws-0-REGION.pooler.supabase.com:5432/postgres
# Leave unset if DATABASE_URL is already a direct/session connection.
# DIRECT_URL=

# Signs the web app's JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me
JWT_EXPIRES_IN=30d

# Shared secret the Raspberry Pi sends as `x-api-key` on POST /pi_data.
# Must match PI_INGEST_KEY in raspberry_pi/.env. Generate with: openssl rand -hex 32
PI_INGEST_KEY=replace-me

# FOG Assistant chatbot (POST /llm_bot). https://console.groq.com/keys
GROQ_API_KEY=replace-me
GROQ_MODEL=openai/gpt-oss-120b

# Browser origins allowed to call this API, comma-separated.
# Local dev + your Vercel domain, e.g.
# CORS_ORIGINS=http://localhost:8080,https://tremorsense.vercel.app
CORS_ORIGINS=http://localhost:8080

# Optional: cap the Postgres connection pool (small tiers / pgbouncer).
# PG_POOL_MAX=10
